{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anti-AI-Slop EVIDENCE-001 local-Git binding manifest",
  "$comment": "Documentary schema only; runtime verifies local Git objects, SHA-256, duplicate keys and all claimed control bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "assessment_version",
    "subject",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "assessment_id": {
      "const": "SVC"
    },
    "assessment_version": {
      "const": "0.1.1"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_hint",
        "commit",
        "answers"
      ],
      "properties": {
        "repository_hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "answers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/relpath"
            },
            "sha256": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "artifacts"
        ],
        "properties": {
          "control_id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]{2}$"
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "kind"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/relpath"
                },
                "sha256": {
                  "$ref": "#/$defs/digest"
                },
                "kind": {
                  "enum": [
                    "test_report",
                    "review_record",
                    "configuration",
                    "design_record",
                    "scan_report",
                    "build_manifest",
                    "other"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "relpath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Runtime enforces safe POSIX relative paths"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
